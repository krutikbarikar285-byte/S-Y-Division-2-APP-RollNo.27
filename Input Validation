def validate(func):
    def wrapper(*args):
        for i in args:
            if not isinstance(i, int) or i <= 0:
                print("Error: All arguments must be positive integers.")
                return
        return func(*args)
    return wrapper

@validate
def multiply(a, b):
    print("Result:", a * b)

multiply(5, 4)
multiply(5, -2)
