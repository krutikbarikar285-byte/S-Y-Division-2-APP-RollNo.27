import pandas as pd
import numpy as np

s = pd.Series(np.random.randint(1, 100, 10))

print("Series:")
print(s)

print("Element at index 2:", s[2])

print("Filtered Values:")
print(s[s > 50])

print("Mean:", s.mean())
print("Median:", s.median())
print("Minimum:", s.min())
print("Maximum:", s.max())
